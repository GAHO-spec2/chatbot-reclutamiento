# Copia este archivo a .env en local. Nunca subas .env al repositorio.
# En Render, configura estas variables en el dashboard del servicio.

NODE_ENV=development
PORT=3000

# OpenAI (requerido: el servidor no arranca sin esta clave)
OPENAI_API_KEY=

# Firebase Admin (requerido en producción).
# Opción 1: JSON completo de la cuenta de servicio en una sola línea.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opción 2: variables separadas.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# URL pública del sitio (sin / final)
PUBLIC_BASE_URL=http://localhost:3000

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Administradores
ADMIN_EMAILS=
PRIMARY_ADMIN_EMAILS=

# Correo
EMAIL_MODE=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
