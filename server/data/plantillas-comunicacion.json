    "contenidoHtml": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta\n    name=\"viewport\"\n    content=\"width=device-width, initial-scale=1.0\"\n  >\n\n  <title>\n    Postulación recibida\n  </title>\n</head>\n\n<body\n  style=\"\n    margin:0;\n    padding:0;\n    background:#f2f5f9;\n    font-family:Arial,Helvetica,sans-serif;\n    color:#25324a;\n  \"\n>\n  <table\n    role=\"presentation\"\n    width=\"100%\"\n    cellspacing=\"0\"\n    cellpadding=\"0\"\n    border=\"0\"\n    style=\"\n      width:100%;\n      background:#f2f5f9;\n      padding:30px 12px;\n    \"\n  >\n    <tr>\n      <td align=\"center\">\n\n        <table\n          role=\"presentation\"\n          width=\"650\"\n          cellspacing=\"0\"\n          cellpadding=\"0\"\n          border=\"0\"\n          style=\"\n            width:100%;\n            max-width:650px;\n            background:#ffffff;\n            border-radius:18px;\n            overflow:hidden;\n            box-shadow:0 14px 40px rgba(31,44,68,0.12);\n          \"\n        >\n          <tr>\n            <td\n              style=\"\n                padding:30px;\n                background:linear-gradient(\n                  135deg,\n                  #111b2e,\n                  #244d88\n                );\n                text-align:center;\n              \"\n            >\n              <h1\n                style=\"\n                  margin:0;\n                  color:#ffffff;\n                  font-size:25px;\n                \"\n              >\n                GA Hospitality\n              </h1>\n\n              <p\n                style=\"\n                  margin:8px 0 0;\n                  color:#d9e4f4;\n                  font-size:14px;\n                \"\n              >\n                Departamento de Reclutamiento\n              </p>\n            </td>\n          </tr>\n\n          <tr>\n            <td\n              style=\"\n                padding:34px 34px 26px;\n              \"\n            >\n              <p\n                style=\"\n                  margin:0 0 8px;\n                  color:#718096;\n                  font-size:13px;\n                  font-weight:bold;\n                  text-transform:uppercase;\n                  letter-spacing:0.06em;\n                \"\n              >\n                Solicitud recibida\n              </p>\n\n              <h2\n                style=\"\n                  margin:0 0 18px;\n                  color:#162238;\n                  font-size:26px;\n                  line-height:1.25;\n                \"\n              >\n                ¡Gracias por postularte,\n                {{nombre}}!\n              </h2>\n\n              <p\n                style=\"\n                  margin:0 0 20px;\n                  color:#55637a;\n                  font-size:15px;\n                  line-height:1.75;\n                \"\n              >\n                Hemos recibido correctamente tu solicitud.\n                Nuestro equipo comenzará a revisar tu\n                información y experiencia.\n              </p>\n\n              <table\n                role=\"presentation\"\n                width=\"100%\"\n                cellspacing=\"0\"\n                cellpadding=\"0\"\n                border=\"0\"\n                style=\"\n                  margin:24px 0;\n                  padding:22px;\n                  background:#f6f8fc;\n                  border:1px solid #e6ebf2;\n                  border-radius:13px;\n                \"\n              >\n                <tr>\n                  <td\n                    style=\"\n                      padding:7px 0;\n                      color:#6a768b;\n                      font-size:13px;\n                    \"\n                  >\n                    Folio\n                  </td>\n\n                  <td\n                    align=\"right\"\n                    style=\"\n                      padding:7px 0;\n                      color:#17243a;\n                      font-size:13px;\n                      font-weight:bold;\n                    \"\n                  >\n                    {{folio}}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td\n                    style=\"\n                      padding:7px 0;\n                      color:#6a768b;\n                      font-size:13px;\n                    \"\n                  >\n                    Vacante\n                  </td>\n\n                  <td\n                    align=\"right\"\n                    style=\"\n                      padding:7px 0;\n                      color:#17243a;\n                      font-size:13px;\n                      font-weight:bold;\n                    \"\n                  >\n                    {{vacante}}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td\n                    style=\"\n                      padding:7px 0;\n                      color:#6a768b;\n                      font-size:13px;\n                    \"\n                  >\n                    Sucursal\n                  </td>\n\n                  <td\n                    align=\"right\"\n                    style=\"\n                      padding:7px 0;\n                      color:#17243a;\n                      font-size:13px;\n                      font-weight:bold;\n                    \"\n                  >\n                    {{sucursal}}\n                  </td>\n                </tr>\n\n                <tr>\n                  <td\n                    style=\"\n                      padding:7px 0;\n                      color:#6a768b;\n                      font-size:13px;\n                    \"\n                  >\n                    Estado\n                  </td>\n\n                  <td\n                    align=\"right\"\n                    style=\"\n                      padding:7px 0;\n                      color:#1b8b58;\n                      font-size:13px;\n                      font-weight:bold;\n                    \"\n                  >\n                    Solicitud recibida\n                  </td>\n                </tr>\n              </table>\n\n              <p\n                style=\"\n                  margin:0 0 24px;\n                  color:#55637a;\n                  font-size:14px;\n                  line-height:1.7;\n                \"\n              >\n                Conserva tu folio. Lo necesitarás para\n                consultar el avance de tu proceso.\n              </p>\n\n              <div\n                style=\"\n                  text-align:center;\n                \"\n              >\n                <a\n                  href=\"{{estatusUrl}}\"\n                  style=\"\n                    display:inline-block;\n                    padding:14px 24px;\n                    background:#286bd6;\n                    color:#ffffff;\n                    text-decoration:none;\n                    border-radius:9px;\n                    font-size:14px;\n                    font-weight:bold;\n                  \"\n                >\n                  Consultar mi estatus\n                </a>\n              </div>\n            </td>\n          </tr>\n\n          <tr>\n            <td\n              style=\"\n                padding:20px 30px;\n                background:#edf1f6;\n                color:#7b8799;\n                text-align:center;\n                font-size:12px;\n                line-height:1.6;\n              \"\n            >\n              {{empresa}} · Departamento de Reclutamiento\n            </td>\n          </tr>\n        </table>\n\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
